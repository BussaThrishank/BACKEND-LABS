      "name": "GET pagination",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/?limit=2&offset=2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "limit",
              "value": "2"
